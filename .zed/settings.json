{
  "terminal": {
    "shell": {
      "with_arguments": {
        "program": "devenv",
        "args": ["shell"],
        "title_override": "CS ADSS Course Notes — Devenv"
      }
    }
  },
  "languages": {
    "Markdown": {
      "language_servers": ["rumdl", "harper-ls"],
      "preferred_line_length": 79,
      "formatter": {
        "external": {
          "command": "panache",
          "arguments": ["format", "--stdin-filename", "{buffer_path}"]
        }
      }
    },
    "Quarto": {
      "language_servers": ["rumdl", "harper-ls"],
      "preferred_line_length": 79,
      "formatter": {
        "external": {
          "command": "panache",
          "arguments": ["format", "--stdin-filename", "{buffer_path}"]
        }
      }
    }
  }
}
